# Per-app deploy knobs. Append these to /etc/<app>/env on the box (box-local, never committed).
# auto-deploy.sh reads them via the systemd unit's EnvironmentFile=/etc/<app>/env, so they keep
# every per-site specific out of this (shared, possibly public) repo.

# How to apply new code:
#   reload  — graceful gunicorn SIGHUP (needs ExecReload in the app's own .service). Default.
#   restart — full restart, for apps with no ExecReload (brief downtime).
DEPLOY_RELOAD=reload

# Args for `uv sync` during a deploy. Add --no-dev to skip dev dependencies.
DEPLOY_UV_ARGS=--frozen

# Apps with a SQLite-snapshot build: name the build unit. When a deploy changes data/build_db.py,
# the poller dispatches this (rebuild snapshot + reload onto new code+schema together) instead of a
# bare reload, which would 500 on a stale schema. Omit for apps with no snapshot (e.g. Postgres).
# DEPLOY_BUILD_SERVICE=<app>-build.service

# Optional Cloudflare edge purge after a deploy (bin/cf-purge.sh). Omit both to skip the purge.
# CF_ZONE_ID=...
# CF_CACHE_PURGE_TOKEN=...
